#!/bin/sh
# Git 自动化预提交钩子：
# 每次执行 git commit 时，自动将 agent/agent.py 中的 AGENT_VERSION 更新为当前真实的北京时间戳 (格式: 26.MMDD.HHMM)
# 确保全网所有节点通过 git pull 拉取代码后，均拥有确定、统一且精确的代码发布版本指纹。

python -c "
import os, time, re

agent_file = os.path.join('agent', 'agent.py')
if os.path.exists(agent_file):
    now_ver = time.strftime('26.%m%d.%H%M')
    try:
        with open(agent_file, 'r', encoding='utf-8') as f:
            content = f.read()
        new_content, count = re.subn(r'AGENT_VERSION = \"[^\"]*\"', f'AGENT_VERSION = \"{now_ver}\"', content)
        if count > 0 and new_content != content:
            with open(agent_file, 'w', encoding='utf-8') as f:
                f.write(new_content)
            print(f'[*] [Git Hook] 自动同步发布版本号: AGENT_VERSION = \"{now_ver}\"')
            os.system('git add ' + agent_file)
    except Exception as e:
        print(f'[!] [Git Hook] 版本号自动注入异常: {e}')
"
exit 0
