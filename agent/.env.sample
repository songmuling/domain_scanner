# ==============================================================================
# Domain Agent 分布式扫描节点环境变量配置模板
# ==============================================================================
# 使用说明：
# 1. 复制本模板为 .env 文件:
#    cp .env.sample .env
# 2. 根据实际情况修改下方的 HUB_URL、HUB_TOKEN 和 NODE_ID
# 3. 启动 Agent 容器:
#    docker compose up -d
# ==============================================================================

# Hub 中心调度端通信地址 (如公网 IP、内网 IP 或域名，带端口)
HUB_URL=http://your-hub-ip:8088

# 集群通信鉴权 Token (可在 Web 控制台右上角【🤖 接入 Agent】查看并一键复制)
HUB_TOKEN=your_token_here

# 当前 Agent 节点唯一标识名 (如 Google-US, Oracle-KR, OpenWrt-Home 等)
NODE_ID=My-Node-Name

# [可选] 本机最大并发线程数上限 (安全约束，运行时取 min(Hub下发, MAX_THREADS))
# 留空或不填表示无限制 (完全遵循 Hub 调度下发的线程数)
# 推荐配置: Oracle-JP=50, Google-US=40, Oracle-KR=45, 软路由=20~25
MAX_THREADS=
