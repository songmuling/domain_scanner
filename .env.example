# ==========================================
# Domain Hub & Agent 集群环境变量配置模板
# 复制为 .env 使用，切勿提交到公共仓库
# ==========================================

# 通信鉴权 Token (Server 与 Agent 保持一致)
HUB_TOKEN=your_secure_random_token_here_32chars

# Agent 连接 Server 的地址 (推荐使用 ZeroTier 内网 IP)
HUB_URL=http://192.168.200.12:8088

# 当前 Agent 节点标识 (可留空，留空将自动根据主机名识别)
NODE_ID=Oracle-JP
